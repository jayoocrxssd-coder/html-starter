# ---------------------------------------------------------------------------
# ATHLYST Affiliate Dashboard — server config
# Copy this file to `.env` and fill in the Shopify values when you're ready
# to pull live sales. The app runs fully without them (manual + seeded data).
# ---------------------------------------------------------------------------

# Where the SQLite database lives. Leave as-is for local dev.
DATABASE_URL="file:./dev.db"

# Port the API/server listens on.
PORT=3001

# --- Shopify Admin API (feature 2: live sales pull) -------------------------
# Create a custom app in your Shopify admin:
#   Settings -> Apps and sales channels -> Develop apps -> Create an app
#   -> Configuration -> Admin API scopes: enable `read_orders`, `read_discounts`
#   -> API credentials -> Install -> reveal the Admin API access token.
# Then paste the values below. Until they're set, "Sync sales" is disabled.
SHOPIFY_SHOP=""                 # e.g. athlyst.myshopify.com
SHOPIFY_ADMIN_TOKEN=""          # shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION="2025-01"   # Admin API version to target
