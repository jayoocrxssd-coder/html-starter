{%- liquid
  assign instagram_url = section.settings.instagram_url
  assign youtube_url = section.settings.youtube_url
  assign back_link = section.settings.back_link | default: '/'
  assign form_id = 'ContactPageForm-' | append: section.id
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Share+Tech+Mono&display=swap" rel="stylesheet">

<div class="contact-page" id="contact-page-{{ section.id }}">
  <canvas class="contact-page__canvas" id="contact-page-canvas-{{ section.id }}"></canvas>

  <a href="{{ back_link }}" class="contact-page__back-link">&larr; BACK</a>

  <div class="contact-page__content">
    <div class="contact-page__heading">
      <div class="contact-page__title">{{ section.settings.heading | default: 'Contact' }}</div>
      <div class="contact-page__subtitle">{{ section.settings.subheading | default: 'Get in touch' }}</div>
    </div>

    {%- form 'contact', id: form_id, class: 'contact-page__form' -%}
      <input name="contact[id]" type="hidden" value="{{ form_id }}">

      {%- liquid
        assign form_matches = false
        if form.id == form_id or form.id == blank
          assign form_matches = true
        endif
      -%}

      <div class="contact-page__field">
        <label class="contact-page__label" for="ContactPage-name-{{ section.id }}">NAME</label>
        <input
          type="text"
          id="ContactPage-name-{{ section.id }}"
          class="contact-page__input"
          autocomplete="name"
          name="contact[name]"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          placeholder="Your name"
        >
      </div>

      <div class="contact-page__field">
        <label class="contact-page__label" for="ContactPage-email-{{ section.id }}">EMAIL</label>
        <input
          type="email"
          id="ContactPage-email-{{ section.id }}"
          class="contact-page__input"
          autocomplete="email"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' and form_matches %}
            aria-invalid="true"
            aria-describedby="ContactPage-email-error-{{ section.id }}"
          {% endif %}
          placeholder="your@email.com"
          required
        >
      </div>

      <div class="contact-page__field">
        <label class="contact-page__label" for="ContactPage-body-{{ section.id }}">MESSAGE</label>
        <textarea
          rows="4"
          id="ContactPage-body-{{ section.id }}"
          class="contact-page__input contact-page__input--textarea"
          name="contact[body]"
          placeholder="Write your message..."
        >{{- form.body -}}</textarea>
      </div>

      <button type="submit" class="contact-page__submit">SEND MESSAGE</button>

      <div class="contact-page__status" id="contact-page-status-{{ section.id }}" tabindex="-1">
        {%- if form.posted_successfully? and form_matches -%}
          MESSAGE SENT — THANK YOU.
        {%- elsif form.errors and form_matches -%}
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        {%- endif -%}
      </div>
    {%- endform -%}

    <div class="contact-page__social">
      {%- if instagram_url != blank -%}
        <a href="{{ instagram_url }}" class="contact-page__social-link" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      {%- endif -%}
      {%- if youtube_url != blank -%}
        <a href="{{ youtube_url }}" class="contact-page__social-link" aria-label="YouTube" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.5 6.2s-.3-1.9-1.1-2.7c-1.1-1.1-2.3-1.1-2.8-1.2C16.8 2 12 2 12 2s-4.8 0-7.6.3c-.6.1-1.8.1-2.8 1.2C.8 4.3.5 6.2.5 6.2S.2 8.4.2 10.6v2.1c0 2.2.3 4.4.3 4.4s.3 1.9 1.1 2.7c1.1 1.1 2.5 1.1 3.1 1.2C6.7 21.1 12 21.1 12 21.1s4.8 0 7.6-.3c.6-.1 1.8-.1 2.8-1.2.8-.8 1.1-2.7 1.1-2.7s.3-2.2.3-4.4v-2.1c0-2.2-.3-4.4-.3-4.4zM9.7 15.5V8.4l7.6 3.6-7.6 3.5z"></path>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-page {
    position: fixed;
    inset: 0;
    background: #ffffff;
    overflow: hidden auto;
    z-index: 0;
  }

  .contact-page__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .contact-page__back-link {
    position: absolute;
    top: 24px;
    left: 24px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(0, 0, 0, 0.45);
    text-decoration: none;
    z-index: 10;
    transition: color 0.15s ease;
  }

  .contact-page__back-link:hover {
    color: #000000;
  }

  .contact-page__content {
    position: relative;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 96px 24px 48px;
    box-sizing: border-box;
    animation: contact-page-fade-up 0.6s ease both;
  }

  .contact-page__heading {
    margin-bottom: 28px;
    text-align: center;
  }

  .contact-page__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 0.22em;
    color: #000000;
    text-transform: uppercase;
    animation: contact-page-glow-pulse 3s ease-in-out infinite;
  }

  .contact-page__subtitle {
    font-family: 'Share Tech Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.35);
    text-transform: uppercase;
    margin-top: 4px;
  }

  .contact-page__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 220px;
    max-width: 100%;
  }

  .contact-page__field {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .contact-page__label {
    font-family: 'Share Tech Mono', monospace;
    font-size: 7px;
    letter-spacing: 0.14em;
    color: rgba(0, 0, 0, 0.4);
  }

  .contact-page__input {
    font-family: 'Share Tech Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    color: #000000;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.35);
    padding: 5px 0 4px;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .contact-page__input:focus {
    border-bottom-color: #000000;
  }

  .contact-page__input--textarea {
    border: 1px solid rgba(0, 0, 0, 0.35);
    padding: 7px 8px;
    resize: none;
    line-height: 1.6;
  }

  .contact-page__input--textarea:focus {
    border-color: #000000;
  }

  .contact-page__submit {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: #000000;
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.55);
    padding: 5px 20px 3px;
    cursor: pointer;
    margin-top: 6px;
    animation: contact-page-glow-pulse 3s ease-in-out infinite 0.5s;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .contact-page__submit:hover {
    background: rgba(0, 0, 0, 0.06);
    border-color: #000000;
  }

  .contact-page__status {
    font-family: 'Share Tech Mono', monospace;
    font-size: 7px;
    letter-spacing: 0.12em;
    color: rgba(0, 0, 0, 0.45);
    text-align: center;
    min-height: 12px;
  }

  .contact-page__social {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }

  .contact-page__social-link {
    display: flex;
    color: rgba(0, 0, 0, 0.5);
    transition: color 0.15s ease;
  }

  .contact-page__social-link:hover {
    color: #000000;
  }

  @keyframes contact-page-glow-pulse {
    0%, 100% { text-shadow: 0 0 4px rgba(0, 0, 0, 0.12); }
    50% { text-shadow: 0 0 8px rgba(0, 0, 0, 0.25); }
  }

  @keyframes contact-page-fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.getElementById('contact-page-{{ section.id }}');
    if (!root || root.dataset.contactPageInit === 'true') return;
    root.dataset.contactPageInit = 'true';

    var canvas = document.getElementById('contact-page-canvas-{{ section.id }}');
    var animFrame = null;
    var resizeHandler = null;

    function initStarfield() {
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var W = (canvas.width = canvas.offsetWidth);
      var H = (canvas.height = canvas.offsetHeight);

      var stars = Array.from({ length: 320 }, function () {
        return {
          x: Math.random() * W,
          y: Math.random() * H,
          baseR: Math.random() * 1.4 + 0.3,
          baseAlpha: Math.random() * 0.55 + 0.1,
          twinkleSpeed: Math.random() * 1.8 + 0.6,
          twinklePhase: Math.random() * Math.PI * 2,
          driftX: (Math.random() - 0.5) * 0.18,
          driftY: (Math.random() - 0.5) * 0.12,
          pulseSpeed: Math.random() * 1.2 + 0.4,
          pulsePhase: Math.random() * Math.PI * 2,
          burstTimer: Math.random() * 8,
          burstDuration: 0,
          colored: Math.random() > 0.96
        };
      });

      function animate() {
        ctx.clearRect(0, 0, W, H);
        var t = Date.now() / 1000;
        stars.forEach(function (s) {
          s.x += s.driftX * 0.016;
          s.y += s.driftY * 0.016;
          if (s.x < -2) s.x = W + 2;
          if (s.x > W + 2) s.x = -2;
          if (s.y < -2) s.y = H + 2;
          if (s.y > H + 2) s.y = -2;

          var twinkle = 0.45 + 0.55 * Math.sin(t * s.twinkleSpeed + s.twinklePhase);
          var pulse = 0.8 + 0.2 * Math.sin(t * s.pulseSpeed + s.pulsePhase);

          s.burstTimer -= 0.016;
          var burst = 0;
          if (s.burstTimer <= 0) {
            s.burstDuration = 0.35;
            s.burstTimer = 7 + Math.random() * 10;
          }
          if (s.burstDuration > 0) {
            burst = s.burstDuration / 0.35;
            s.burstDuration -= 0.016;
          }

          var a = Math.min(1, s.baseAlpha * twinkle + burst * 0.6);
          var r = s.baseR * pulse * (1 + burst * 1.2);

          ctx.beginPath();
          ctx.arc(s.x, s.y, r, 0, Math.PI * 2);
          ctx.fillStyle = s.colored ? 'rgba(80,100,180,' + a + ')' : 'rgba(0,0,0,' + a + ')';
          ctx.fill();

          if (burst > 0.5) {
            ctx.strokeStyle = 'rgba(0,0,0,' + burst * 0.25 + ')';
            ctx.lineWidth = 0.5;
            var len = r * 3;
            ctx.beginPath();
            ctx.moveTo(s.x - len, s.y);
            ctx.lineTo(s.x + len, s.y);
            ctx.moveTo(s.x, s.y - len);
            ctx.lineTo(s.x, s.y + len);
            ctx.stroke();
          }
        });
        animFrame = requestAnimationFrame(animate);
      }

      if (animFrame) cancelAnimationFrame(animFrame);
      animate();
    }

    initStarfield();

    resizeHandler = function () {
      initStarfield();
    };
    window.addEventListener('resize', resizeHandler);

    var status = document.getElementById('contact-page-status-{{ section.id }}');
    if (status && status.textContent.trim() !== '') {
      status.focus();
    }

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.target.id !== 'contact-page-{{ section.id }}' && !event.target.contains(root)) return;
      if (animFrame) cancelAnimationFrame(animFrame);
      if (resizeHandler) window.removeEventListener('resize', resizeHandler);
    });
  })();
</script>

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "class": "contact-page-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "back_link",
      "label": "Back link",
      "info": "Defaults to the homepage if left blank."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    }
  ],
  "presets": [
    {
      "name": "Contact page"
    }
  ]
}
{% endschema %}
