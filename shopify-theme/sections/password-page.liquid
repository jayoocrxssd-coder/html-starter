{%- liquid
  assign instagram_url = section.settings.instagram_url
  assign youtube_url = section.settings.youtube_url
  assign wordmark = section.settings.wordmark | default: shop.name
  assign heading = section.settings.heading | default: 'Coming soon'
  assign hint = section.settings.hint | default: 'Enter password to access the store'
  assign form_id = 'PasswordPageForm-' | append: section.id
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Share+Tech+Mono&display=swap" rel="stylesheet">

<div class="password-page" id="password-page-{{ section.id }}">
  <canvas class="password-page__canvas" id="password-page-canvas-{{ section.id }}"></canvas>

  <div class="password-page__content">
    <div class="password-page__brand">
      <div class="password-page__wordmark">{{ wordmark }}</div>
      <span class="password-page__clock" id="password-page-clock-{{ section.id }}"></span>
    </div>

    <div class="password-page__lock" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
    </div>

    <div class="password-page__heading">{{ heading }}</div>

    {%- form 'storefront_password', id: form_id, class: 'password-page__form-wrapper' -%}
      <div class="password-page__hint" id="password-page-hint-{{ section.id }}" tabindex="-1">
        {%- if form.errors -%}
          {{ 'content.wrong_password' | t }}
        {%- else -%}
          {{ hint }}
        {%- endif -%}
      </div>

      <div class="password-page__form{% if form.errors %} password-page__form--shake{% endif %}">
        <div class="password-page__field">
          <label class="visually-hidden" for="PasswordPageInput-{{ section.id }}">
            {{ 'placeholders.password' | t }}
          </label>
          <input
            type="password"
            name="password"
            id="PasswordPageInput-{{ section.id }}"
            class="password-page__input"
            autocomplete="current-password"
            placeholder="••••••••"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="password-page-hint-{{ section.id }}"
            {% endif %}
            autofocus
          >
        </div>

        <button type="submit" class="password-page__submit">Enter</button>
      </div>
    {%- endform -%}

    {%- if shop.password_message != blank -%}
      <div class="password-page__message">{{ shop.password_message }}</div>
    {%- endif -%}

    <div class="password-page__social">
      {%- if instagram_url != blank -%}
        <a href="{{ instagram_url }}" class="password-page__social-link" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      {%- endif -%}
      {%- if youtube_url != blank -%}
        <a href="{{ youtube_url }}" class="password-page__social-link" aria-label="YouTube" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.5 6.2s-.3-1.9-1.1-2.7c-1.1-1.1-2.3-1.1-2.8-1.2C16.8 2 12 2 12 2s-4.8 0-7.6.3c-.6.1-1.8.1-2.8 1.2C.8 4.3.5 6.2.5 6.2S.2 8.4.2 10.6v2.1c0 2.2.3 4.4.3 4.4s.3 1.9 1.1 2.7c1.1 1.1 2.5 1.1 3.1 1.2C6.7 21.1 12 21.1 12 21.1s4.8 0 7.6-.3c.6-.1 1.8-.1 2.8-1.2.8-.8 1.1-2.7 1.1-2.7s.3-2.2.3-4.4v-2.1c0-2.2-.3-4.4-.3-4.4zM9.7 15.5V8.4l7.6 3.6-7.6 3.5z"></path>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .password-page {
    position: fixed;
    inset: 0;
    background: #ffffff;
    overflow: hidden;
    z-index: 0;
  }

  .password-page__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .password-page__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
    animation: password-page-fade-in 0.8s ease both;
  }

  .password-page__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 40px;
    animation: password-page-float 4s ease-in-out infinite;
  }

  .password-page__wordmark {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #000000;
  }

  .password-page__clock {
    font-family: 'Share Tech Mono', monospace;
    font-size: 9px;
    color: rgba(0, 0, 0, 0.4);
    letter-spacing: 0.08em;
  }

  .password-page__lock {
    margin-bottom: 28px;
    color: rgba(0, 0, 0, 0.25);
    display: flex;
  }

  .password-page__heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 15px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #000000;
    margin-bottom: 6px;
    text-align: center;
  }

  .password-page__form-wrapper {
    display: contents;
  }

  .password-page__hint {
    font-family: 'Share Tech Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.1em;
    color: rgba(0, 0, 0, 0.35);
    text-align: center;
    margin-bottom: 28px;
    min-height: 12px;
  }

  .password-page__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 220px;
    max-width: 100%;
  }

  .password-page__form--shake {
    animation: password-page-shake 0.4s ease;
  }

  .password-page__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .password-page__input {
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #000000;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.3);
    padding: 6px 0 5px;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .password-page__input::placeholder {
    color: rgba(0, 0, 0, 0.25);
  }

  .password-page__input:focus {
    outline: none;
    border-bottom-color: rgba(0, 0, 0, 0.8);
  }

  .password-page__input[aria-invalid='true'] {
    border-bottom-color: rgba(0, 0, 0, 0.7);
  }

  .password-page__submit {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #000000;
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.55);
    padding: 6px 24px 4px;
    cursor: pointer;
    width: 100%;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .password-page__submit:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .password-page__message {
    margin-top: 20px;
    max-width: 260px;
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.5);
    text-align: center;
  }

  .password-page__social {
    display: flex;
    gap: 16px;
    margin-top: 40px;
  }

  .password-page__social-link {
    display: flex;
    color: rgba(0, 0, 0, 0.4);
    transition: color 0.15s ease;
  }

  .password-page__social-link:hover {
    color: #000000;
  }

  @keyframes password-page-float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-7px); }
  }

  @keyframes password-page-fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes password-page-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(4px); }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.getElementById('password-page-{{ section.id }}');
    if (!root || root.dataset.passwordPageInit === 'true') return;
    root.dataset.passwordPageInit = 'true';

    var clockEl = document.getElementById('password-page-clock-{{ section.id }}');
    function startClock() {
      if (!clockEl) return;
      function tick() {
        var now = new Date();
        var est = new Date(now.toLocaleString('en-US', { timeZone: 'America/New_York' }));
        var mm = String(est.getMonth() + 1).padStart(2, '0');
        var dd = String(est.getDate()).padStart(2, '0');
        var yyyy = est.getFullYear();
        var h = est.getHours();
        var ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        var min = String(est.getMinutes()).padStart(2, '0');
        var sec = String(est.getSeconds()).padStart(2, '0');
        clockEl.textContent = mm + '/' + dd + '/' + yyyy + '  ' + h + ':' + min + ':' + sec + ' ' + ampm + ' EST';
      }
      tick();
      setInterval(tick, 1000);
    }

    var canvas = document.getElementById('password-page-canvas-{{ section.id }}');
    var animFrame = null;

    function initStarfield() {
      if (!canvas) return;
      var ctx = canvas.getContext('2d');

      function resize() {
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      var stars = Array.from({ length: 380 }, function () {
        return {
          x: Math.random(),
          y: Math.random(),
          baseR: Math.random() * 1.5 + 0.25,
          baseAlpha: Math.random() * 0.5 + 0.08,
          twinkleSpeed: Math.random() * 2 + 0.5,
          twinklePhase: Math.random() * Math.PI * 2,
          driftX: (Math.random() - 0.5) * 0.1,
          driftY: (Math.random() - 0.5) * 0.08,
          pulseSpeed: Math.random() * 1.2 + 0.3,
          pulsePhase: Math.random() * Math.PI * 2,
          burstTimer: Math.random() * 10,
          burstDuration: 0,
          colored: Math.random() > 0.97
        };
      });

      function animate() {
        var W = canvas.width, H = canvas.height;
        ctx.clearRect(0, 0, W, H);
        var t = Date.now() / 1000;
        stars.forEach(function (s) {
          s.x += (s.driftX * 0.016) / W;
          s.y += (s.driftY * 0.016) / H;
          if (s.x < 0) s.x = 1;
          if (s.x > 1) s.x = 0;
          if (s.y < 0) s.y = 1;
          if (s.y > 1) s.y = 0;

          var twinkle = 0.4 + 0.6 * Math.sin(t * s.twinkleSpeed + s.twinklePhase);
          var pulse = 0.8 + 0.2 * Math.sin(t * s.pulseSpeed + s.pulsePhase);

          s.burstTimer -= 0.016;
          var burst = 0;
          if (s.burstTimer <= 0) {
            s.burstDuration = 0.4;
            s.burstTimer = 8 + Math.random() * 12;
          }
          if (s.burstDuration > 0) {
            burst = s.burstDuration / 0.4;
            s.burstDuration -= 0.016;
          }

          var a = Math.min(1, s.baseAlpha * twinkle + burst * 0.55);
          var r = s.baseR * pulse * (1 + burst * 1.1);

          ctx.beginPath();
          ctx.arc(s.x * W, s.y * H, r, 0, Math.PI * 2);
          ctx.fillStyle = s.colored ? 'rgba(80,100,180,' + a + ')' : 'rgba(0,0,0,' + a + ')';
          ctx.fill();

          if (burst > 0.5) {
            ctx.strokeStyle = 'rgba(0,0,0,' + burst * 0.22 + ')';
            ctx.lineWidth = 0.5;
            var len = r * 3.5;
            ctx.beginPath();
            ctx.moveTo(s.x * W - len, s.y * H);
            ctx.lineTo(s.x * W + len, s.y * H);
            ctx.moveTo(s.x * W, s.y * H - len);
            ctx.lineTo(s.x * W, s.y * H + len);
            ctx.stroke();
          }
        });
        animFrame = requestAnimationFrame(animate);
      }
      animate();
    }

    startClock();
    initStarfield();

    var hint = document.getElementById('password-page-hint-{{ section.id }}');
    if (hint && root.querySelector('.password-page__form--shake')) {
      hint.focus();
    }

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.target.id !== 'password-page-{{ section.id }}' && !event.target.contains(root)) return;
      if (animFrame) cancelAnimationFrame(animFrame);
    });
  })();
</script>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "password-page-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "info": "Defaults to your store name if left blank.",
      "default": "CRXSSWEI"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint text",
      "default": "Enter password to access the store"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    }
  ]
}
{% endschema %}
