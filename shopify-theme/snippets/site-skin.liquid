{% doc %}
  Site-wide visual skin matching the landing-page design system
  (Bebas Neue / Share Tech Mono, black-on-white, glow-pulse hover).
  Purely additive CSS — restyles the existing header/nav and the
  catalog (collection) grid without touching any theme markup or JS.

  @example
  {% render 'site-skin' %}
{% enddoc %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Share+Tech+Mono&display=swap" rel="stylesheet">

<style>
  /* Header / nav */
  .header {
    background: #ffffff !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .header-logo {
    font-family: 'Bebas Neue', sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .menu-list__link-title {
    font-family: 'Bebas Neue', sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.85em;
  }

  .menu-list__link {
    transition: text-shadow 0.2s ease, opacity 0.2s ease;
  }

  .menu-list__link:hover .menu-list__link-title,
  .menu-list__link:focus-visible .menu-list__link-title,
  .menu-list__link--active .menu-list__link-title {
    text-shadow: 0 0 8px rgba(0, 0, 0, 0.35);
  }

  .header-actions__action,
  .search-action,
  .account-button,
  .action__cart {
    color: rgba(0, 0, 0, 0.55);
    transition: color 0.15s ease;
  }

  .header-actions__action:hover,
  .search-action:hover,
  .account-button:hover,
  .action__cart:hover {
    color: #000000;
  }

  /* Catalog / collection grid */
  .facets--filters-title,
  .facets__label,
  .facets-horizontal-remove,
  .facets__clear-all-link,
  .sorting-filter__label,
  .sorting-filter__select,
  .sorting-filter__option,
  .products-count-wrapper,
  .filter-count-bubble__text {
    font-family: 'Share Tech Mono', monospace !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-card__content .text-block {
    font-family: 'Share Tech Mono', monospace;
    letter-spacing: 0.03em;
  }

  .product-card {
    transition: opacity 0.2s ease;
  }

  .product-card:hover {
    opacity: 0.85;
  }

  /* Page transitions — swipe instead of Horizon's default fade/slide-up.
     Overrides the same custom properties base.css already animates via
     the View Transitions API, so this covers standard page navigation
     (catalog, product, contact, policies, etc.) and the product page's
     detail panel when navigating in from a collection grid. */
  @media (prefers-reduced-motion: no-preference) {
    :root {
      --view-transition-old-main-content: 0.32s ease-in-out both site-skin-swipe-out;
      --view-transition-new-main-content: 0.32s ease-in-out both site-skin-swipe-in;
    }

    @keyframes site-skin-swipe-out {
      from {
        transform: translateX(0);
        opacity: 1;
      }

      to {
        transform: translateX(-3%);
        opacity: 0;
      }
    }

    @keyframes site-skin-swipe-in {
      from {
        transform: translateX(3%);
        opacity: 0;
      }

      to {
        transform: translateX(0);
        opacity: 1;
      }
    }
  }
</style>
